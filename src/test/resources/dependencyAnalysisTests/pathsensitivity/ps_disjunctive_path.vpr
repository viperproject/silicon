method disjunctive_path(a: Int, b: Int)
{
  var x: Int

  if (@dependencyInfo("assumptionType:PathCondition, label:L1")(a == 0 || b == 0)) {
    if (@dependencyInfo("assumptionType:PathCondition, label:L2")(a == 0)) {
      @dependencyInfo("assumptionType:SourceCode, label:L3")
      x := 1
    } else {
      @dependencyInfo("assumptionType:SourceCode, label:L4")
      x := 2
    }
  } else {
    @dependencyInfo("assumptionType:SourceCode, label:L5")
    x := 3
  }

  if (@dependencyInfo("assumptionType:PathCondition, label:L6")(a != 0 && b == 0)) {
    @dependencyInfo("assertionType:Explicit, label:L7, expectedDependencies:[L4,L6]")
    assert x == 2
  }
}
