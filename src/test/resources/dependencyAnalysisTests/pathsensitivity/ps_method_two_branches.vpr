method choose(flag: Bool, a: Int, b: Int) returns (res: Int)
  requires @dependencyInfo("assumptionType:Precondition, label:L1, expectedDependencies:[L10,L8]")(a == 1)
  requires @dependencyInfo("assumptionType:Precondition, label:L2, expectedDependencies:[L10,L9]")(b == 2)
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L3, expectedDependencies:[L5,L6,L1,L10,L8]")(flag ==> res == 1)
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L4, expectedDependencies:[L5,L7,L2,L10,L9]")(!flag ==> res == 2)
{
  if (@dependencyInfo("assumptionType:PathCondition, label:L5")(flag)) {
    @dependencyInfo("assumptionType:SourceCode, label:L6")
    res := a
  } else {
    @dependencyInfo("assumptionType:SourceCode, label:L7")
    res := b
  }
}

method client()
{
  var a: Int
  var b: Int
  var r: Int

  @dependencyInfo("assumptionType:SourceCode, label:L8")
  a := 1
  @dependencyInfo("assumptionType:SourceCode, label:L9")
  b := 2
  @dependencyInfo("assumptionType:MethodCall, assertionType:MethodCall, label:L10, expectedDependencies:[L8,L9]")
  r := choose(true, a, b)

  @dependencyInfo("assertionType:Explicit, label:L11, expectedDependencies:[L10,L3,L5,L6,L1,L8]")
  assert r == 1
}
