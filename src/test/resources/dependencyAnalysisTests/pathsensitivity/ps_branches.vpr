method client(a: Int, b: Int)
{
  var v: Int

  if (@dependencyInfo("assumptionType:PathCondition, label:L1")(a < 0)) {
    @dependencyInfo("assumptionType:SourceCode, label:L2")
    v := 1
    if (@dependencyInfo("assumptionType:PathCondition, label:L3")(a == 10)){
      @dependencyInfo("assumptionType:SourceCode, label:L4")
      v := 10
    }
    @dependencyInfo("assumptionType:SourceCode, label:L5")
    v := 5
  } else {
    @dependencyInfo("assumptionType:SourceCode, label:L6")
    v := b
    if (@dependencyInfo("assumptionType:PathCondition, label:L7")(a == 20)){
      @dependencyInfo("assumptionType:SourceCode, label:L8")
      v := 20
    }
  }

  if (@dependencyInfo("assumptionType:PathCondition, label:L9")(a < 0)) {
    @dependencyInfo("assertionType:Explicit, label:L10, expectedDependencies:[L1,L5,L9]")
    assert v == 5
  }
}
