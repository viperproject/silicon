field f: Int

method currentPerm(x: Ref)
    requires @dependencyInfo("assumptionType:Precondition, label:L1")(acc(x.f, 1/2))
{
    @dependencyInfo("assertionType:Explicit, label:L2, expectedDependencies:[L1]")
    assert perm(x.f) > 1/4
}

method perm1(){
    var x: Ref
    @dependencyInfo("assumptionType:SourceCode, label:L3")
    x := new(f)

    inhale @dependencyInfo("assertionType:Implicit, label:L4, expectedDependencies:[L3]") (x.f > 0)
}

method perm2(){
    var x: Ref
    inhale @dependencyInfo("assumptionType:Explicit, label:L5") (acc(x.f, 1/2))

    inhale @dependencyInfo("assumptionType:Explicit, assertionType:Implicit, label:L6, expectedDependencies:[L5]") (x.f > 0)
}

method perm3(){
    var x: Ref
    inhale @dependencyInfo("assumptionType:Explicit, label:L7") (acc(x.f))

    @dependencyInfo("assumptionType: SourceCode, assertionType:SourceCode, label:L8, expectedDependencies:[L7]")
    x.f := 5
}

method perm4(){
    var x: Ref
    inhale @dependencyInfo("assumptionType:Explicit, label:L9") (acc(x.f))

    inhale @dependencyInfo("assumptionType:Explicit, assertionType: Implicit, label:L10, expectedDependencies:[L9]") (x.f > 0)

    @dependencyInfo("assumptionType:SourceCode, assertionType: Implicit, label:L11, expectedDependencies:[L9]")
    x.f := x.f + 1

    @dependencyInfo("assertionType:Explicit, label:L12, expectedDependencies:[L9,L10,L11]")
    assert x.f > 1
}

method perm5(){
    var x: Ref
    inhale @dependencyInfo("assumptionType:Explicit, label:L13") (acc(x.f))

    @dependencyInfo("assumptionType:SourceCode, assertionType: Implicit, label:L14, expectedDependencies:[L13]")
    x.f := x.f + 1

    @dependencyInfo("assertionType:Explicit, label:L15, expectedDependencies:[L13]")
    exhale acc(x.f)
}

method permAmount1(x: Ref, p: Perm)
   requires @dependencyInfo("assumptionType:Precondition, label:L16")(p > none)
   requires @dependencyInfo("assumptionType:Precondition, label:L17")(acc(x.f, p))
 {
   assume @dependencyInfo("assumptionType:Explicit, label:L18") (p > 1/2)

   @dependencyInfo("assertionType:Explicit, label:L19, expectedDependencies:[L16,L17,L18]")
   exhale acc(x.f, 1/2)
 }

 method permAmount2(x: Ref, p: Perm)
   requires @dependencyInfo("assumptionType:Precondition, label:L24") (p > none)
   requires @dependencyInfo("assumptionType:Precondition, label:L20")(acc(x.f, p))
 {
   @dependencyInfo("assumptionType:Explicit, assertionType:Implicit, label:L21, expectedDependencies:[L20,L24]")
   inhale x.f > 0
   assume @dependencyInfo("assumptionType:Explicit, label:L22") (p > 1/2)

   @dependencyInfo("assertionType:Explicit, label:L25, expectedDependencies:[L22,L20,L24]")
   exhale acc(x.f, 1/2)

   @dependencyInfo("assertionType:Explicit, label:L23, expectedDependencies:[L20,L21,L22,L24]")
   assert x.f > 0
 }
