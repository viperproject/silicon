field f: Int

method quantifiedPerm1(xs: Seq[Ref]) {
  assume @dependencyInfo("assumptionType:Explicit, label:L1")(|xs| > 5)
  inhale @dependencyInfo("assumptionType:Explicit, label:L2")(forall x: Ref :: x in xs ==> acc(x.f))

  inhale @dependencyInfo("assumptionType:Explicit, assertionType:Implicit, label:L50, expectedDependencies:[L1]") (xs[0] != xs[1])

  var i: Int
  @dependencyInfo("assumptionType:SourceCode, label:L3")
  i := 0

  @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode, label:L4, expectedDependencies:[L1,L2]")
  xs[0].f := 10
}

method quantifiedPerm2(xs: Seq[Ref]) {
  assume @dependencyInfo("assumptionType:Explicit, label:L5")(|xs| > 5)
  inhale @dependencyInfo("assumptionType:Explicit, label:L6")(forall x: Ref :: x in xs ==> acc(x.f))

  inhale @dependencyInfo("assumptionType:Explicit, assertionType:Implicit, label:L51, expectedDependencies:[L5]") (xs[0] != xs[4])

  @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode, label:L7, expectedDependencies:[L5,L6]")
  xs[0].f := xs[1].f + xs[4].f
}

method quantifiedPerm3(xs: Seq[Ref], y: Ref) {
  assume @dependencyInfo("assumptionType:Explicit, label:L8")(|xs| > 5)
  inhale @dependencyInfo("assumptionType:Explicit, label:L9")(forall x: Ref :: x in xs ==> acc(x.f))
  inhale @dependencyInfo("assumptionType:Explicit, label:L10")(acc(y.f, wildcard))

  @dependencyInfo("assertionType:Explicit, label:L11, expectedDependencies:[L8,L9,L10]")
  assert xs[0] != y
}

method quantifiedExhalePartiallyTest(xs: Seq[Ref]) {
  var res: Int
  assume @dependencyInfo("assumptionType:Explicit, label:L52") (|xs| > 5)
  inhale @dependencyInfo("assumptionType:Explicit, label:L12")(forall x: Ref :: x in xs ==> acc(x.f))

  inhale @dependencyInfo("assumptionType:Explicit, assertionType:Implicit, label:L53, expectedDependencies:[L52]") (xs[0] != xs[4])

  var i: Int
  @dependencyInfo("assumptionType:SourceCode, label:L13")
  i := 0

  @dependencyInfo("assertionType:Explicit, label:L14, expectedDependencies:[L12]")
  exhale forall x: Ref :: x in xs ==> acc(x.f, 1/2)
}

method quantifiedExhalePartially(xs: Seq[Ref]) {
  var res: Int
  assume @dependencyInfo("assumptionType:Explicit, label:L15")(|xs| > 5)
  inhale @dependencyInfo("assumptionType:Explicit, label:L16")(forall x: Ref :: x in xs ==> acc(x.f))

  exhale @dependencyInfo("assertionType:Explicit, label:L54, expectedDependencies:[L16]") (forall x: Ref :: x in xs ==> acc(x.f, 1/2))

  var i: Int
  @dependencyInfo("assumptionType:SourceCode, label:L17")
  i := 1

  @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode, label:L18, expectedDependencies:[L15,L16]")
  res := xs[1].f + 1
}

method quantifiedExhaleFully(xs: Seq[Ref]) {
  assume @dependencyInfo("assumptionType:Explicit, label:L55") (|xs| > 5)
  inhale @dependencyInfo("assumptionType:Explicit, label:L19")(forall x: Ref :: x in xs ==> acc(x.f))

  inhale @dependencyInfo("assumptionType:Explicit, assertionType:Implicit, label:L56, expectedDependencies:[L55]") (xs[0] != xs[2])

  @dependencyInfo("assertionType:Explicit, label:L20, expectedDependencies:[L19]")
  exhale forall x: Ref :: x in xs ==> acc(x.f)
}

method quantifiedPermWrite1(xs: Seq[Ref]) {
  assume @dependencyInfo("assumptionType:Explicit, label:L21") (|xs| > 5)

  @dependencyInfo("assumptionType:Explicit, label:L22")
  inhale forall x: Ref :: x in xs ==> (acc(x.f) && x.f > 0)

  inhale @dependencyInfo("assumptionType:Explicit, assertionType:Implicit, label:L57, expectedDependencies:[L21]") (xs[0] != xs[2])

  @dependencyInfo("assertionType:SourceCode, label:L23, expectedDependencies:[L21,L22]")
  xs[0].f := 0
}

method quantifiedPermWrite2(xs: Seq[Ref]) {
  assume @dependencyInfo("assumptionType:Explicit, label:L24") (|xs| > 5)
  @dependencyInfo("assumptionType:Explicit, label:L25")
  inhale forall x: Ref :: x in xs ==> (acc(x.f) && x.f > 0)

  @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode, label:L26, expectedDependencies:[L24,L25]")
  xs[0].f := 0

  inhale @dependencyInfo("assumptionType:Explicit, assertionType:Implicit, label:L58, expectedDependencies:[L24]") (xs[0] != xs[2])

  @dependencyInfo("assertionType:Explicit, label:L27, expectedDependencies:[L24,L25,L26]")
  assert xs[0].f == 0
}

method quantifiedPermWrite3(xs: Seq[Ref]) {
  assume @dependencyInfo("assumptionType:Explicit, label:L28") (|xs| > 5)
  @dependencyInfo("assumptionType:Explicit, label:L29")
  inhale forall x: Ref :: x in xs ==> (acc(x.f) && x.f > 0)

  @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode, label:L30, expectedDependencies:[L28,L29]")
  xs[0].f := 0

  @dependencyInfo("assertionType:Explicit, label:L31, expectedDependencies:[L28,L29]")
  assert xs[0] != xs[1] ==> xs[1].f > 0
}

method quantifiedPermWrite4(xs: Seq[Ref], ys: Seq[Ref])
  requires @dependencyInfo("assumptionType:Precondition, label:L32")(|xs| > 5)
  requires @dependencyInfo("assumptionType:Precondition, label:L59")(|ys| > 3)
{
  @dependencyInfo("assumptionType:Explicit, label:L33")
  inhale forall x: Ref :: x in xs ==> acc(x.f)
  @dependencyInfo("assumptionType:Explicit, label:L34")
  inhale forall y: Ref :: y in ys ==> acc(y.f)

  @dependencyInfo("assumptionType:Explicit, assertionType:Implicit, label:L60, expectedDependencies:[L59]")
  inhale ys[0] != ys[1]

  @dependencyInfo("assertionType:SourceCode, label:L35, expectedDependencies:[L32,L33]")
  xs[0].f := 2
}
