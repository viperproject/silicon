field f:Int

method loop1(){
    var i: Int
    var res: Int
    @dependencyInfo("assumptionType:SourceCode, label:L1")
    res := 0
    @dependencyInfo("assumptionType:SourceCode, label:L36")
    i := 10
    while(@dependencyInfo("assumptionType:PathCondition, label:L2")(i > 0))
        invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L3, expectedDependencies:[L36,L37]")(i <= 10)
        invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L4, expectedDependencies:[L2,L36,L37]")(i >= 0)
        invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L5, expectedDependencies:[L1,L2,L6,L36,L37]")(res >= 0)
    {
        @dependencyInfo("assumptionType:SourceCode, label:L6")
        res := res + i
        @dependencyInfo("assumptionType:SourceCode, label:L37")
        i := i - 1
    }


    @dependencyInfo("assertionType:Explicit, label:L7, expectedDependencies:[L1,L2,L5,L6,L36,L37]")
    assert res >= 0
}

