method loop4(){
    var i: Int
    var res: Int


    @dependencyInfo("assumptionType:SourceCode, label:L26")
    res := 0
    @dependencyInfo("assumptionType:SourceCode, label:L27")
    i := 10
    while(@dependencyInfo("assumptionType:PathCondition, label:L28")(i > 0))
        invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L29, expectedDependencies:[L27,L33]")(i <= 10)
        invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L30, expectedDependencies:[L27,L28,L33]")(i >= 0)
        invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L31, expectedDependencies:[L26]")(res >= 0)
    {
        @dependencyInfo("assumptionType:SourceCode, label:L32")
        res := res - 1
        @dependencyInfo("assumptionType:SourceCode, label:L33")
        i := i - 1

        assume @dependencyInfo("assumptionType:Explicit, label:L34") (res > 0)
    }

    @dependencyInfo("assertionType:Explicit, label:L35, expectedDependencies:[L26,L31]")
    assert res >= 0
}
