method compute(a: Int, b: Int, c: Int) returns (res: Int)
    requires @dependencyInfo("assumptionType:Precondition, label:L1, expectedDependencies:[L9,L6]")(a == 10)
    requires @dependencyInfo("assumptionType:Precondition, label:L2, expectedDependencies:[L9,L7]")(b == 20)
    requires @dependencyInfo("assumptionType:Precondition, label:L3, expectedDependencies:[L9,L8]")(c == 30)
    ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L4, expectedDependencies:[L1,L2,L5]")(res == 5)
{
    @dependencyInfo("assumptionType:SourceCode, label:L5")
    res := (a + b) / 6
}

method client() {
    var a: Int
    @dependencyInfo("assumptionType:SourceCode, label:L6")
    a := 10
    var b: Int
    @dependencyInfo("assumptionType:SourceCode, label:L7")
    b := 20
    var c: Int
    @dependencyInfo("assumptionType:SourceCode, label:L8")
    c := 30
    var res: Int
    @dependencyInfo("assumptionType:MethodCall, assertionType:MethodCall, label:L9, expectedDependencies:[L6,L7,L8]")
    res := compute(a, b, c)
    @dependencyInfo("assertionType:Explicit, label:L10, expectedDependencies:[L6,L7,L8,L9,L4,L5]")
    assert res == 5
}
