method synchronise(val: Int) returns (res: Int)
  requires @dependencyInfo("assumptionType:Precondition, label:L10") (val > 0)
  ensures @dependencyInfo("assumptionType:ExplicitPostcondition, label:L12") (val == res)

method mutually_exclusive(flag: Bool)
{
  var x: Int

  if (@dependencyInfo("assumptionType:PathCondition, label:L1")(flag)) {
    @dependencyInfo("assumptionType:SourceCode, label:L2")
    x := 7
  } else {
    @dependencyInfo("assumptionType:SourceCode, label:L3")
    x := 9
  }

  @dependencyInfo("assumptionType:MethodCall, assertionType:MethodCall, label:L11, expectedDependencies:[L2,L3]")
  x := synchronise(x)

  if (@dependencyInfo("assumptionType:PathCondition, label:L4")(!flag)) {
    @dependencyInfo("assertionType:Explicit, label:L5, expectedDependencies:[L10,L11,L12,L4,L3,L1]")
    assert x == 9
  } else {
    @dependencyInfo("assertionType:Explicit, label:L6, expectedDependencies:[L10,L11,L12,L4,L1,L2]")
    assert x == 7
  }
}
