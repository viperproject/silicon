// taken from silver test suite
method binary_search(array: Seq[Int], key: Int) returns (index: Int)
   requires @dependencyInfo("assertionType:Precondition, label:L1")(forall i: Int, j: Int :: 0 <= i && j < |array| && i < j ==> array[i] <= array[j])
   ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L2, expectedDependencies:[L17]")(-1 <= index && index < |array|)
   ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L3, expectedDependencies:[L17]")(0 <= index ==> array[index] == key)
   ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L4, expectedDependencies:[L1,L5,L6,L8,L10,L11,L12,L13,L14,L15,L17]")(-1 == index ==> (forall i: Int :: 0 <= i && i < |array| ==> array[i] != key))
{
  var low: Int 
  var high: Int
  var mid : Int
  @dependencyInfo("assumptionType:SourceCode, label:L5")
  low := 0
  @dependencyInfo("assumptionType:SourceCode, label:L6")
  high := |array|
  @dependencyInfo("assumptionType:SourceCode, label:L7")
  index := -1
  
  while (@dependencyInfo("assumptionType:PathCondition, label:L8")(low < high))
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L9, expectedDependencies:[L5,L6,L8,L11,L12,L13,L14,L15]")(0 <= low && low <= high && high <= |array|)
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L10, expectedDependencies:[L1,L5,L6,L8,L11,L12,L13,L14,L15]")(forall i: Int :: (0 <= i && i < |array| && !(low <= i && i < high)) ==> array[i] != key)
  {
    @dependencyInfo("assumptionType:SourceCode, label:L11, expectedDependencies:[L8,L9]")
    mid := (low + high) \ 2;
    if (@dependencyInfo("assumptionType:PathCondition, assertionType:PathCondition, label:L12, expectedDependencies:[L8,L5,L6,L11,L15,L13]")(array[mid] < key)) {
      @dependencyInfo("assumptionType:SourceCode, label:L13")
      low := mid + 1;
    } else {
      if (@dependencyInfo("assumptionType:PathCondition, assertionType:PathCondition, label:L14, expectedDependencies:[L8,L5,L6,L11,L15,L13]")(key < array[mid])) {
         @dependencyInfo("assumptionType:SourceCode, label:L15")
         high := mid;
      } else {
        @dependencyInfo("assumptionType:SourceCode, label:L16")
        index := mid
      }
    }
  }
  @dependencyInfo("assumptionType:SourceCode, label:L17")
  index := -1
}
