field val: Int
field edges: IEdges

// Total function that returns null for those elements that are not present.
domain IEdges {
  function edge_lookup(e: IEdges, i: Int): Ref
  function has_edge(e: IEdges, i: Int): Bool
  function insert_edge(e: IEdges, i: Int, node: Ref): IEdges
  function edges_domain(e: IEdges): Set[Int]
  function empty_edges(): IEdges

  // INSERTION

  axiom inserted_edge_present {
    forall e: IEdges, i: Int, node: Ref :: edge_lookup(insert_edge(e, i, node), i) == node
  }

  axiom other_edges_preserved_after_insertion {
    forall e: IEdges, i: Int, node: Ref, j: Int :: i != j ==> edge_lookup(e, j) == edge_lookup(insert_edge(e, i, node), j)
  }

  axiom inserted_edge_defined {
    forall e: IEdges, i: Int, node: Ref :: has_edge(insert_edge(e, i, node), i)
  }

  // HAS EDGE

  axiom has_edge_complete {
    forall e: IEdges, i: Int :: has_edge(e, i) <==> edge_lookup(e, i) != null
  }

  // DOMAIN

  axiom edges_domain_defined {
    forall e: IEdges, i: Int :: i in edges_domain(e) <==> has_edge(e, i)
  }

  // EMPTY MAP

  axiom empty_edges_has_no_nodes {
    forall i: Int :: !(has_edge(empty_edges(), i))
  }
}

domain INodeMap {
  function lookup(node_map: INodeMap, node: Ref): Ref
  function has_node(node_map: INodeMap, node: Ref): Bool
  function insert(node_map: INodeMap, key_node: Ref, val_node: Ref): INodeMap
  function map_domain(node_map: INodeMap): Seq[Ref]
  function empty_map(): INodeMap

  // INSERTION

  axiom inserted_node_present {
   forall node_map: INodeMap, key_node: Ref, val_node: Ref :: lookup(insert(node_map, key_node, val_node), key_node) == val_node
  }

  axiom other_nodes_preserved_after_insertion {
    forall node_map: INodeMap, key_node: Ref, val_node: Ref, node: Ref :: node != key_node ==> lookup(node_map, node) == lookup(insert(node_map, key_node, val_node), node)
  }

  axiom inserted_node_defined {
    forall node_map: INodeMap, key_node: Ref, val_node: Ref :: has_node(insert(node_map, key_node, val_node), key_node)
  }

  // HAS NODE

  axiom has_node_complete {
    forall node_map: INodeMap, node: Ref :: has_node(node_map, node) <==> lookup(node_map, node) != null
  }

  // DOMAIN

  axiom domain_is_defined {
    forall node_map: INodeMap, key: Ref:: key in map_domain(node_map) <==> has_node(node_map, key)
  }

  // EMPTY MAP

  axiom empty_map_has_no_nodes {
    forall node: Ref :: !(has_node(empty_map(), node))
  }
}

method graph_copy_rec(this: Ref, node_map: INodeMap, setOfRef: Set[Ref], node_map_image: Set[Ref], rd: Perm)
    returns (nodeCopy: Ref, res_node_map: INodeMap, res_copy_nodes: Set[Ref])

  requires @dependencyInfo("assumptionType:Precondition, label:L1, expectedDependencies:[L48]")(none < rd)
  requires @dependencyInfo("assumptionType:Precondition, label:L2, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(this != null)
  // Precondition about setOfRef
  requires @dependencyInfo("assumptionType:Precondition, label:L3, expectedDependencies:[L1,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(this in setOfRef)
  requires @dependencyInfo("assumptionType:Precondition, label:L4, expectedDependencies:[L1,L3,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(|setOfRef intersection node_map_image| == 0)
  requires @dependencyInfo("assumptionType:Precondition, label:L5, expectedDependencies:[L1,L3,L4,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in setOfRef ==> acc(x.val, rd))
  requires @dependencyInfo("assumptionType:Precondition, label:L6, expectedDependencies:[L1,L3,L4,L5,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in setOfRef ==> acc(x.edges, rd))
  requires @dependencyInfo("label:L7")(forall x: Ref, i: Int :: (x in setOfRef && i in edges_domain(x.edges)) ==> edge_lookup(x.edges, i) in setOfRef)
  // Precondition about node_map_image

      // ASSUMPTIONTYPE BROKEN FOR L7, L8!!
      // DEPENDENCIES BROKEN
      // L8 , expectedDependencies:[L53]
      // L7 , expectedDependencies:[L1,L3,L4,L5,L6,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]

  requires @dependencyInfo("label:L8")(forall x: Ref :: x in map_domain(node_map) ==> (lookup(node_map, x) in node_map_image))
  requires @dependencyInfo("assumptionType:Precondition, label:L9, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in node_map_image ==> acc(x.val))
  requires @dependencyInfo("assumptionType:Precondition, label:L10, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in node_map_image ==> acc(x.edges))

  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L11, expectedDependencies:[L1,L2,L3,L4,L5,L6,L7,L8,L9,L10,L22,L23,L25,L26,L28,L29,L31,L32,L33,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(nodeCopy != null && nodeCopy in res_copy_nodes)

  // EXPECTED TRIGGER RELATED LABEL L30 IN:
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L12, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L25,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(|setOfRef intersection res_copy_nodes| == 0) // L30 EXPECTED


  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L13, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in setOfRef ==> acc(x.val, rd))
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L14, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L36,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in setOfRef ==> x.val == old(x.val))
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L15, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in setOfRef ==> acc(x.edges, rd))
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L16, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L38,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in setOfRef ==> x.edges == old(x.edges))
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L17, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref, i: Int :: x in setOfRef && i in edges_domain(x.edges) ==> edge_lookup(x.edges, i) in setOfRef)
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L18, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L25,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(res_copy_nodes == res_copy_nodes union old(node_map_image))
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L19, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L24,L25,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in map_domain(res_node_map) ==> lookup(res_node_map,x) in res_copy_nodes)
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L20, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L25,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in res_copy_nodes ==> acc(x.val))
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L21, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L25,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in res_copy_nodes ==> acc(x.edges))
{
  var i: Int // an edge index
  var S: Set[Int]

  if (@dependencyInfo("assumptionType:PathCondition, label:L22")(has_node(node_map, this))) {
    @dependencyInfo("assumptionType:SourceCode, label:L23")
    nodeCopy := lookup(node_map, this)
    @dependencyInfo("assumptionType:SourceCode, label:L24")
    res_node_map := node_map
    @dependencyInfo("assumptionType:SourceCode, label:L25")
    res_copy_nodes := node_map_image
  } else {
    @dependencyInfo("assumptionType:SourceCode, label:L26")
    nodeCopy := new(val, edges)
    @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode, label:L27, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")
    nodeCopy.val := this.val

    @dependencyInfo("assumptionType:SourceCode, label:L28")
    res_node_map := insert(node_map, this, nodeCopy)

    @dependencyInfo("assumptionType:SourceCode, label:L29")
    res_copy_nodes := node_map_image union Set(nodeCopy)

    /* The next assert is needed in order to prove that the loop invariant
     *   assert |setOfRef intersection res_copy_nodes| == 0
     * holds before the loop.
     *
     * See https://bitbucket.org/viperproject/silver/issues/111
     */
    @trigger()
    @dependencyInfo("assertionType:Explicit, label:L30, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")
    assert (setOfRef intersection node_map_image) union (setOfRef intersection Set(nodeCopy))
           == setOfRef intersection res_copy_nodes

    @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode, label:L31, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")
    S := edges_domain(this.edges)

    while (@dependencyInfo("assumptionType:PathCondition, label:L32")(|S| > 0))
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L33, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(nodeCopy in res_copy_nodes)
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L34, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(this in setOfRef)
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L35, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in setOfRef ==> acc(x.val, rd))
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L36, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in setOfRef ==> x.val == old(x.val))
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L37, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in setOfRef ==> acc(x.edges, rd))
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L38, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall x: Ref :: x in setOfRef ==> x.edges == old(x.edges))
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L39, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall j: Int :: j in S ==> edge_lookup(this.edges, j) in setOfRef)
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L40, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(forall r: Ref, j: Int :: r in setOfRef && j in edges_domain(r.edges) ==> edge_lookup(r.edges, j) in setOfRef)
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L41, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L42,L43,L44,L45,L46,L47,L48,L51,L53]")(node_map_image subset res_copy_nodes)

      // EXPECTED TRIGGER RELATED LABEL L30 IN:
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L42, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L43,L44,L45,L46,L47,L48,L51,L53]")(|setOfRef intersection res_copy_nodes| == 0) // L30 EXPECTED



      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L43, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L44,L45,L46,L47,L48,L51,L53]")(forall r: Ref :: r in map_domain(res_node_map) ==> lookup(res_node_map,r) in res_copy_nodes)
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L44, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L45,L46,L47,L48,L51,L53]")(forall r: Ref :: r in res_copy_nodes ==> acc(r.val))
      invariant @dependencyInfo("assumptionType:LoopInvariant, assertionType:LoopInvariant, label:L45, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L46,L47,L48,L51,L53]")(forall r: Ref :: r in res_copy_nodes ==> acc(r.edges))
    {
      @dependencyInfo("assumptionType:MethodCall, assertionType:MethodCall, label:L46, expectedDependencies:[L32]")
      S, i := pop(S)

      var newNode: Ref
      var newResultMap: INodeMap
      var nodeForId: Ref

      @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode, label:L47, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L48,L51,L53]")
      nodeForId := edge_lookup(this.edges, i)

      @dependencyInfo("assumptionType:MethodCall, assertionType:MethodCall, label:L48, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L51,L53]")
      newNode, res_node_map, res_copy_nodes := graph_copy_rec(nodeForId, res_node_map, setOfRef, res_copy_nodes, rd/2)

      @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode, label:L49, expectedDependencies:[L1,L3,L4,L5,L6,L7,L8,L9,L10,L26,L28,L29,L31,L32,L33,L35,L37,L39,L40,L41,L42,L43,L44,L45,L46,L47,L48,L51,L53]")
      nodeCopy.edges := insert_edge(nodeCopy.edges, i, newNode)
    }
  }
}

/* Non-deterministically remove an int from s1, yielding an updated s2 and the removed int i */
method pop(s1: Set[Int]) returns (s2: Set[Int], i: Int)
  requires @dependencyInfo("assumptionType:Precondition, label:L50, expectedDependencies:[L32,L46]")(0 < |s1|)
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L51, expectedDependencies:[L53]")(i in s1)
  ensures  @dependencyInfo("assertionType:ImplicitPostcondition, label:L52, expectedDependencies:[L53]")(s2 == s1 setminus Set(i))
{ assume @dependencyInfo("assumptionType:Explicit, label:L53")(false) /* Effectively an unimplemented helper method */ }
