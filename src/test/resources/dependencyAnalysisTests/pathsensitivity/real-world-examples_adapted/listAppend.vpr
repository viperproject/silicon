field elem: Int
field next: Ref

predicate list(this: Ref) {
  acc(this.elem) && acc(this.next) &&
  (this.next != null ==> list(this.next))
}

function listLength(l:Ref) : Int
  requires @dependencyInfo("assumptionType:Precondition, label:L34, expectedDependencies:[L36]")(list(l))
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L35, expectedDependencies:[L34,L36]")(result > 0)
{
  @dependencyInfo("assumptionType:FunctionBody, label:L36")(unfolding list(l) in l.next == null ? 1 : 1 + listLength(l.next))
}

method appendList1(this: Ref, e: Int)
  requires @dependencyInfo("assumptionType:Precondition, label:L1, expectedDependencies:[L3,L5,L39,L40]")(list(this))
  requires @dependencyInfo("assumptionType:Precondition, label:L2, expectedDependencies:[L1,L3,L5,L39,L40]")(0 <= e)
  requires @dependencyInfo("assumptionType:Precondition, label:L1112, expectedDependencies:[L1,L3,L5,L39,L40]")(e < 100)
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L37, expectedDependencies:[L1,L2,L3,L5,L6,L8,L9,L10,L38,L39,L40,L1112]")(list(this))
{
  @dependencyInfo("assumptionType:Rewrite, assertionType:Rewrite, label:L3, expectedDependencies:[L1,L5,L39,L40]")
  unfold list(this)
  @dependencyInfo("assumptionType:Explicit, assertionType:Implicit, label:L4, expectedDependencies:[L1,L2,L3,L5,L39,L40,L1112]")
  assume 0 <= this.elem && this.elem < 100

  if (@dependencyInfo("assumptionType:PathCondition, assertionType:PathCondition, label:L5, expectedDependencies:[L1,L3,L39,L40]")(this.next == null)) {
    var n: Ref

    @dependencyInfo("assumptionType:SourceCode, label:L6")
    n := new(elem, next)
    @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode label:L7, expectedDependencies:[L6]")
    n.elem := e
    @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode label:L8, expectedDependencies:[L6]")
    n.next := null
    @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode label:L9, expectedDependencies:[L1,L3,L5,L39,L40]")
    this.next := n
    @dependencyInfo("assumptionType:Rewrite, assertionType:Rewrite, label:L10, expectedDependencies:[L6,L8]")
    fold list(n)
  } else {
    var l_next: Ref
    @dependencyInfo("assumptionType:SourceCode, assertionType:SourceCode label:L40, expectedDependencies:[L1,L3,L5,L39]")
    l_next := this.next
    @dependencyInfo("assumptionType:MethodCall, assertionType:MethodCall, label:L39, expectedDependencies:[L1,L2,L3,L5,L40,L1112]")
    appendList1(l_next, e)
  }

  @dependencyInfo("assumptionType:Rewrite, assertionType:Rewrite, label:L38, expectedDependencies:[L1,L2,L3,L5,L6,L8,L9,L10,L39,L40,L1112]")
  fold list(this)
}

