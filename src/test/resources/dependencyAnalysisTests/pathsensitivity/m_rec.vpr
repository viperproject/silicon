method compute_rec(a: Int, b: Int) returns (res: Int)
    requires @dependencyInfo("assumptionType:Precondition, label:L1, expectedDependencies:[L9]")(b >= 0)
    ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L2, expectedDependencies:[L1,L3,L4,L5,L6,L9]")(res == a + b)
{
    if(@dependencyInfo("assumptionType:PathCondition, label:L3")(b == 0)){
        @dependencyInfo("assumptionType:SourceCode, label:L4")
        res := a
    } else {
        var rec: Int
        @dependencyInfo("assumptionType:MethodCall, assertionType:MethodCall, label:L5, expectedDependencies:[L1,L3]")
        rec := compute_rec(a, b-1)
        @dependencyInfo("assumptionType:SourceCode, label:L6")
        res := 1 + rec
    }
}

method client() {
    var a: Int
    @dependencyInfo("assumptionType:SourceCode, label:L8")
    a := 1
    var b: Int
    @dependencyInfo("assumptionType:SourceCode, label:L9")
    b := 2
    var x: Int

    var r3: Int
    @dependencyInfo("assumptionType:MethodCall, assertionType:MethodCall, label:L10, expectedDependencies:[L9]")
    r3 := compute_rec(a, b)

    @dependencyInfo("assertionType:Explicit, label:L17, expectedDependencies:[L8,L9,L2,L4,L5,L6]")
    assert r3 == 3
}
