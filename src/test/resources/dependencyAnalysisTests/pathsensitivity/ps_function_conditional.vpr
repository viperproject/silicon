function pick(flag: Bool, a: Int, b: Int): Int
  requires @dependencyInfo("assumptionType:Precondition, label:L1")(a == 3)
  requires @dependencyInfo("assumptionType:Precondition, label:L2")(b == 4)
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L3")(flag ==> result == 3)
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L4")(!flag ==> result == 4)
{
  @dependencyInfo("assumptionType:FunctionBody, label:L5")(flag ? a : b)
}

method client()
{
  var x: Int
  var y: Int
  var z: Int

  @dependencyInfo("assumptionType:SourceCode, label:L6")
  x := 3
  @dependencyInfo("assumptionType:SourceCode, label:L7")
  y := 4
  @dependencyInfo("assumptionType:SourceCode, label:L8")
  z := pick(false, x, y)

  @dependencyInfo("assertionType:Explicit, label:L9, expectedDependencies:[L8,L7,L5]")
  assert z == 4
}
