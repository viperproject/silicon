function five(a: Int, xy: Int, c: Int): Int
  requires @dependencyInfo("assumptionType:Precondition, label:L1")(a == 10)
  requires @dependencyInfo("assumptionType:Precondition, label:L2")(xy == 20)
  requires @dependencyInfo("assumptionType:Precondition, label:L3")(c == 30)
  ensures @dependencyInfo("assertionType:ImplicitPostcondition, label:L4, expectedDependencies:[L1,L3,L8]")(result == 5)
{
  @dependencyInfo("assumptionType:FunctionBody, label:L8")((a + c) - 35)
}

method client() {
  var p1: Int
  @dependencyInfo("assumptionType:SourceCode, label:L5")
  p1 := 10
  var test: Int
  @dependencyInfo("assumptionType:SourceCode, label:L6")
  test := 20
  var p3: Int
  @dependencyInfo("assumptionType:SourceCode, label:L7")
  p3 := 30
  var res: Int
  @dependencyInfo("assumptionType:SourceCode, label:L9, expectedDependencies:[L5,L6,L7]")
  res := five(p1,test,p3)
  @dependencyInfo("assertionType:Explicit, label:L10, expectedDependencies:[L9,L8,L4,L1,L3,L5,L6,L7]")
  assert res + p3 == 35
}