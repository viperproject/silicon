method divide(a: Int, b: Int) returns (res: Int)
    requires b != 0
    ensures res == a / b      // PQ: 2/3
{
    res := a / b              // PQ: 1/2
}

method client()
{
    var a: Int, b: Int, res: Int
    a := 6         // uncovered
    assume b == 3

    res := divide(a, b)       // PQ: 0/1
}