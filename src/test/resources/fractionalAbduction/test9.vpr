field f: Ref

method example(x: Ref)
    requires acc(x.f, 1/4)
{
    package acc(x.f, 1/2) --* acc(x.f, 1/4)
    //apply acc(x.f, 1/2) --* acc(x.f, 1/4)
    //assert acc(x.f, 1/2) --* acc(x.f, 1/4)
}


method foo(x: Ref, y: Ref)
requires acc(y.f)
//requires acc(x.f)
{
    package acc(x.f) --* acc(y.f)
}