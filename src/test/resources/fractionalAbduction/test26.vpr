  ensures !(x == y) && x.f == y ==> acc(pred(x), write)
{
  if (x.f == null) {
    y := null
  } else {
    y := x}
  if (!(x == y) && y == y) {
    fold acc(pred(x), write)
  }
  if (!(x == null)) {
